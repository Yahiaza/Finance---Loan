# PostgreSQL connection. Create a dedicated database and user for the app.
DATABASE_URL=postgresql://finance_app:CHANGE_THIS_PASSWORD@127.0.0.1:5432/finance_shared

# API listener. Keep 0.0.0.0 for LAN access; restrict the port using Windows Firewall.
FINANCE_HOST=0.0.0.0
FINANCE_PORT=5050

# Folder containing centrally stored PDFs and images.
FINANCE_FILES_DIR=D:\FinanceServer\attachments

# First administrator is created only when the users table is empty.
FINANCE_ADMIN_USERNAME=admin
FINANCE_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
FINANCE_ADMIN_NAME=مدير النظام

# Use true only when PostgreSQL requires TLS (normally false on the same server).
PGSSL=false

# Optional HTTPS for the API. Leave both blank on a trusted LAN/VPN.
# When enabled, use https:// in the desktop application's server address.
FINANCE_TLS_CERT=
FINANCE_TLS_KEY=
